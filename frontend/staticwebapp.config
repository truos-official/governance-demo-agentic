{
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "enabled": true
      },
      "gitHub": {
        "enabled": true
      }
    }
  },
  "routes": [
    {
      "route": "/*",
      "allowedRoles": ["approved"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    },
    "403": {
      "statusCode": 403,
      "rewrite": "/403.html"
    }
  },
  "globalHeaders": {
    "X-Frame-Options": "SAMEORIGIN"
  }
}