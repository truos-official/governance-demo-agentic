# Copy this file to .env and fill in all values before running locally.
# Production secrets live in Azure Key Vault (gov-demo-kv-truos).

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-...

# --- Project ---
PROJECT_NAME=agentic-applications
ENVIRONMENT=development

# --- Azure Cache for Redis ---
REDIS_HOST=governance-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=<from Azure portal: governance-redis → Access keys → Primary>
REDIS_SSL=true
REDIS_SOCKET_TIMEOUT=10
REDIS_SOCKET_CONNECT_TIMEOUT=10

# --- Elasticsearch (Elastic Cloud) ---
ELASTIC_ENDPOINT=https://<deployment-id>.es.<region>.azure.elastic.cloud:443
ELASTIC_API_KEY=<from Elastic Cloud console: Security → API keys>

# --- LangSmith (observability) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=un-governance-demo

# --- Weights & Biases (experiment tracking) ---
WANDB_API_KEY=wandb_v1_...

# --- Azure Language Services (PII detection) ---
AZURE_LANGUAGE_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
AZURE_LANGUAGE_KEY=<from Azure portal: Azure AI Language resource → Keys and Endpoint>

# --- CORS (comma-separated, no trailing slashes) ---
CORS_ORIGINS=http://localhost:3000,https://proud-smoke-08513440f.2.azurestaticapps.net,https://ai.truos.io
